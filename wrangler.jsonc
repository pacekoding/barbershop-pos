{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "barbershop-pos",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-11-10",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "barbershop-pos",
			"database_id": "b6258cb4-f3c5-4180-a9c3-97b0a6a8622f",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05
		}
	}
	// Jangan simpan POLICY_AUD, DEVELOPER_EMAIL, atau secret lokal di repository.
}
